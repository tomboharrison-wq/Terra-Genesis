{
  "name": "terra-genesis",
  "compatibility_date": "2025-01-01",
  // Build the site first, so `wrangler deploy` works even when the Cloudflare Build command is blank.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
